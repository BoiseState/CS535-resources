#!/bin/bash

# Find an available Jupyter port on cscluster00.
START_PORT=8888
END_PORT=8999

for ((port=$START_PORT; port<=$END_PORT; port++)); do
    if ! ss -ltn | awk '{print $4}' | grep -q ":${port}$"; then
        break
    fi
done

if [ "$port" -gt "$END_PORT" ]; then
    echo "ERROR: No available Jupyter port between $START_PORT and $END_PORT."
    exit 1
fi

echo "Starting JupyterLab on cscluster00 port $port"
echo
echo "Create this SSH tunnel from your laptop:"
echo
echo "  ssh -L $port:localhost:$port $(whoami)@cscluster00.boisestate.edu"
echo
echo "Then open:"
echo
echo "  http://localhost:$port"
echo
echo "Press Ctrl-C to stop JupyterLab."
echo

exec python3.11 -m jupyter lab \
    --no-browser \
    --ip=127.0.0.1 \
    --port="$port"
